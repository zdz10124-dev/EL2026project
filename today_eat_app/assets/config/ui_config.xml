<?xml version="1.0" encoding="UTF-8"?>
<uiConfig>
  <!-- 全局应用文案：可直接修改应用标题、页签名字与按钮文字。 -->
  <app>
    <title>今天吃什么</title>
    <subtitle>把每一顿认真记下来</subtitle>
  </app>

  <!-- 主题色：填写十六进制颜色，格式为 #RRGGBB。 -->
  <theme>
    <seedColor>#D96C3D</seedColor>
    <surfaceColor>#FFF7F2</surfaceColor>
    <accentColor>#FFB74D</accentColor>
    <successColor>#4F8A5B</successColor>
  </theme>

  <!-- 尺寸参数：单位默认为逻辑像素。 -->
  <layout>
    <pageHorizontalPadding>20</pageHorizontalPadding>
    <pageVerticalPadding>16</pageVerticalPadding>
    <cameraFrameHeight>320</cameraFrameHeight>
    <cameraActionSize>76</cameraActionSize>
    <secondaryActionSize>58</secondaryActionSize>
    <heroButtonSize>220</heroButtonSize>
    <cardRadius>28</cardRadius>
    <inputRadius>18</inputRadius>
  </layout>

  <!-- 拍照与编辑流程中的文案。 -->
  <capture>
    <cameraTitle>拍下这一顿</cameraTitle>
    <cameraHint>点击下方按钮拍照，或从相册选一张美食照片。</cameraHint>
    <draftNotice>10 分钟内重拍/重选会自动恢复你刚刚填写的内容。</draftNotice>
    <dishLabel>菜品</dishLabel>
    <locationLabel>地点</locationLabel>
    <priceLabel>价格（元）</priceLabel>
    <confirmText>确定</confirmText>
    <retakeText>重拍</retakeText>
    <reselectText>重选</reselectText>
    <placeholderDish>比如：番茄牛腩饭</placeholderDish>
    <placeholderLocation>比如：二食堂一楼</placeholderLocation>
    <placeholderPrice>比如：18</placeholderPrice>
  </capture>

  <!-- “今天吃什么”界面的模式配置。 -->
  <decision>
    <heroTitle>吃点什么</heroTitle>
    <heroSubtitle>点一下，帮你从吃过的记录里选答案</heroSubtitle>
    <randomModeName>随机模式</randomModeName>
    <randomModeDescription>从你记录过的主菜里随机抽一个，适合不想纠结的时候。</randomModeDescription>
    <preferenceModeName>偏好模式</preferenceModeName>
    <preferenceModeDescription>优先推荐你在相近时间段常吃、常打高分的主菜。</preferenceModeDescription>
  </decision>

  <!-- 统计页与设置页的标题文案。 -->
  <pages>
    <recordTab>记录</recordTab>
    <decideTab>吃什么</decideTab>
    <insightTab>其他</insightTab>
    <settingsTab>设置</settingsTab>
    <insightTitle>其他功能</insightTitle>
    <settingsTitle>设置</settingsTitle>
  </pages>
</uiConfig>
